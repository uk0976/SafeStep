# Firebase project config — get these from Firebase Console > Project Settings > General
# after creating a Web App inside your Firebase project.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Groq API key — used ONLY server-side by the /api serverless functions
# (safety-tips, analyze-checkin). Deliberately NOT prefixed with VITE_ so Vite
# never bundles it into client-side JS. Get one free at console.groq.com.
GROQ_API_KEY=
